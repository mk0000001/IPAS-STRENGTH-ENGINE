+"""Browser icons must be public, correctly typed, complete and allowlisted."""
+from html.parser import HTMLParser
+from io import BytesIO
+from urllib.parse import urlsplit
+from xml.etree import ElementTree
+
+from fastapi.testclient import TestClient
+from PIL import Image
+import pytest
+
+from app.main import app, BRAND_ASSETS
+
+
+class BrandLinks(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.links = []
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == 'link' and ('icon' in attrs.get('rel','') or attrs.get('rel') == 'manifest'):
+            self.links.append(attrs)
+
+
+def test_browser_icon_links_work_without_operator_session(monkeypatch):
+    from app import config
+    monkeypatch.setattr(config, 'AUTH_REQUIRED', True)
+    browser = TestClient(app)
+    page = browser.get('/')
+    assert page.status_code == 200
+    links = BrandLinks(); links.feed(page.text)
+    assert len(links.links) == 6
+    for link in links.links:
+        response = browser.get(link['href'])
+        assert response.status_code == 200, link
+        assert response.headers['x-content-type-options'] == 'nosniff'
+        assert response.headers['cache-control'] == 'no-store'
+        path = urlsplit(link['href']).path
+        media_type = 'image/x-icon' if path == '/favicon.ico' else BRAND_ASSETS[path.rsplit('/',1)[1]]
+        assert response.headers['content-type'].split(';')[0] == media_type
+    assert browser.get('/favicon.ico').content == browser.get('/web/favicon.ico').content
+
+
+@pytest.mark.parametrize('name,media_type', sorted(BRAND_ASSETS.items()))
+def test_brand_asset_formats_are_real_and_portable(name, media_type):
+    response = TestClient(app).get('/web/' + name)
+    assert response.status_code == 200
+    assert response.headers['content-type'].split(';')[0] == media_type
+    if name.endswith('.svg'):
+        root = ElementTree.fromstring(response.content)
+        assert root.tag == '{http://www.w3.org/2000/svg}svg'
+        assert root.attrib.get('viewBox')
+        # Fonts may be used for the full name, but the IPAS letters are outlines.
+        assert not any(node.tag.endswith('}script') or 'href' in node.attrib for node in root.iter())
+    elif name.endswith('.png'):
+        expected = {'favicon-16.png':16,'favicon-32.png':32,'apple-touch-icon.png':180,
+                    'icon-192.png':192,'icon-512.png':512}[name]
+        with Image.open(BytesIO(response.content)) as image:
+            assert image.format == 'PNG' and image.size == (expected,expected)
+            assert image.convert('RGBA').getpixel((expected//2,expected//2))[3] == 255
+    elif name.endswith('.ico'):
+        with Image.open(BytesIO(response.content)) as image:
+            assert image.format == 'ICO'
+            assert {(16,16),(32,32),(48,48),(256,256)} <= image.ico.sizes()
+    else:
+        manifest = response.json()
+        assert manifest['name'] == 'Integrated Printing Analysis System'
+        assert manifest['short_name'] == 'IPAS'
+        for icon in manifest['icons']:
+            icon_response = TestClient(app).get(icon['src'])
+            with Image.open(BytesIO(icon_response.content)) as image:
+                assert icon['sizes'] == f'{image.width}x{image.height}'
+
+
+@pytest.mark.parametrize('path', ['/web/config.py','/web/main.py','/web/.env',
+                                '/web/%2e%2e%2fconfig.py','/assets/favicon.ico'])
+def test_asset_routes_do_not_expose_non_allowlisted_files(path):
+    assert TestClient(app).get(path).status_code == 404
