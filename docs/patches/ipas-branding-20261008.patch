+"""The same printable identity appears on all report audiences and formats."""
+from copy import deepcopy
+from io import BytesIO
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+from unittest.mock import patch
+from xml.etree import ElementTree
+
+import pytest
+
+from app import report_pdf
+from app.engine_versions import report_version_lines
+
+
+def pdf_contents(data):
+    command = shutil.which('pdftotext')
+    if command:
+        xml = subprocess.run([command, '-bbox', '-', '-'], input=data,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True).stdout
+        root = ElementTree.fromstring(xml)
+        namespace = {'pdf': 'http://www.w3.org/1999/xhtml'}
+        pages = root.findall('.//pdf:page', namespace)
+        words = [{'text': word.text or '', 'x0': float(word.attrib['xMin']),
+                  'x1': float(word.attrib['xMax']), 'top': float(word.attrib['yMin']),
+                  'bottom': float(word.attrib['yMax'])}
+                 for word in pages[0].findall('pdf:word', namespace)]
+        text = ' '.join(word.text or '' for word in root.findall('.//pdf:word', namespace))
+        return text, words, float(pages[0].attrib['width'])
+    # Bundled Windows QA supplies pdfplumber; the production image uses Poppler.
+    import pdfplumber
+    with pdfplumber.open(BytesIO(data)) as pdf:
+        return ('\n'.join(page.extract_text() or '' for page in pdf.pages),
+                pdf.pages[0].extract_words(), pdf.pages[0].width)
+
+
+@pytest.fixture
+def report_row():
+    return {
+        'id': 'ipas-branding-check',
+        'original_filename': 'branding-part.gcode',
+        'input_json': {'printer': 'H2C', 'material': 'PLA', 'colors': 1,
+            'duration_seconds': 600, 'grams': '10', 'part_count': 1,
+            'input_source': 'GCODE'},
+        'result_json': {'components': [{'code': 'BASE', 'label': '출력', 'amount': '100'}],
+            'subtotal': '100', 'vat': '10', 'shipping': '4000', 'grand_total': '4110',
+            'manual_review_reasons': [], 'warnings': [], 'detected_settings': {}}}
+
+
+@pytest.fixture(autouse=True)
+def report_dependencies():
+    real_font = report_pdf.TTFont
+    def font(name, filename, *args, **kwargs):
+        if sys.platform == 'win32' and not Path(filename).is_file():
+            filename = {'PrintOpsKR': 'C:/Windows/Fonts/malgun.ttf',
+                        'PrintOpsKRBold': 'C:/Windows/Fonts/malgunbd.ttf'}[name]
+        return real_font(name, filename, *args, **kwargs)
+    with patch.object(report_pdf, 'TTFont', side_effect=font), \
+         patch('app.report_geometry.geometry_for_report', return_value={
+             'status': 'NO_GCODE_SOURCE', 'images': [], 'candidates': []}), \
+         patch('app.report_geometry.report_reference', return_value={}):
+        yield
+
+
+@pytest.mark.parametrize('kind', ['basic', 'detailed', 'admin'])
+@pytest.mark.parametrize('combined', [False, True])
+def test_branding_preserves_report_notice_audience_and_amounts(report_row, kind, combined):
+    snapshot = deepcopy(report_row)
+    data = (report_pdf.render_combined_pdf([report_row], kind=kind) if combined
+            else report_pdf.render_pdf(report_row, kind))
+    text, words, page_width = pdf_contents(data)
+    assert data.startswith(b'%PDF')
+    assert b'/Author (IPAS)' in data
+    assert 'Integrated Printing Analysis System' in text
+    assert 'IPAS · ' + ('관리자 전용' if kind == 'admin' else '고객 전달용') in text
+    assert 'PrintOps' not in text and 'PRINTOPS' not in text and 'PIAS' not in text
+    assert '4,110원' in text
+    assert ('보고서 생성 환경: IPAS v' in text) == (kind == 'admin')
+    assert report_row == snapshot
+    notice = next(word for word in words if word['text'] == '처리')
+    brand = next(word for word in words if word['text'] == 'IPAS' and word['top'] < 150)
+    full_name = [word for word in words if word['text'] in
+                 ('Integrated', 'Printing', 'Analysis', 'System') and word['top'] < 150]
+    title = next(word for word in words if word['text'] == ('관리자' if kind == 'admin' else '3D'))
+    assert notice['bottom'] < brand['top'] < min(word['top'] for word in full_name)
+    assert max(word['bottom'] for word in full_name) < title['top']
+    assert len(full_name) == 4
+    assert b'/Subtype /Image' not in data, 'The brand must not add a raster image dependency.'
+    for word in [brand, *full_name]:
+        assert 36 <= word['x0'] < word['x1'] <= page_width - 36
+
+
+def test_report_environment_uses_current_identity_without_touching_saved_versions():
+    result = {'engine_versions': {'gcode': {'version': 'saved-parser'}}}
+    snapshot = deepcopy(result)
+    lines = report_version_lines(result)
+    assert 'IPAS-GCODE ENGINE vsaved-parser' in lines[0]
+    assert lines[1].startswith('보고서 생성 환경: IPAS v')
+    assert result == snapshot
