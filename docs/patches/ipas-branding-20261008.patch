+"""Compact vector branding shared by every PDF report audience."""
+from reportlab.lib import colors
+from reportlab.pdfbase import pdfmetrics
+from reportlab.platypus import Flowable
+
+BRAND_NAME = 'IPAS'
+BRAND_FULL_NAME = 'Integrated Printing Analysis System'
+
+
+class ReportBrand(Flowable):
+    """A vector lockup that fits the space reserved for the report masthead."""
+
+    def __init__(self):
+        super().__init__()
+        self.width = 34 + pdfmetrics.stringWidth(BRAND_FULL_NAME, 'Helvetica', 7.5)
+        self.height = 26
+        self.keepWithNext = True
+
+    def draw(self):
+        canvas = self.canv
+        canvas.saveState()
+        canvas.translate(0, 2)
+        canvas.scale(24 / 64, 24 / 64)
+        canvas.setFillColor(colors.HexColor('#152533'))
+        canvas.roundRect(0, 0, 64, 64, 12, stroke=0, fill=1)
+        canvas.setFillColor(colors.HexColor('#21C6B7'))
+        top = canvas.beginPath()
+        top.moveTo(32, 54)
+        for x, y in ((53, 43), (32, 32), (11, 43)):
+            top.lineTo(x, y)
+        top.close()
+        canvas.drawPath(top, stroke=0, fill=1)
+        canvas.setLineWidth(5)
+        canvas.setLineCap(1)
+        canvas.setLineJoin(1)
+        for stroke, points in (
+            ('#F6FBFC', ((11, 33), (32, 22), (53, 33))),
+            ('#21C6B7', ((11, 22), (32, 11), (53, 22))),
+        ):
+            canvas.setStrokeColor(colors.HexColor(stroke))
+            layer = canvas.beginPath()
+            layer.moveTo(*points[0])
+            for point in points[1:]:
+                layer.lineTo(*point)
+            canvas.drawPath(layer, stroke=1, fill=0)
+        canvas.restoreState()
+        canvas.saveState()
+        canvas.setFillColor(colors.HexColor('#152533'))
+        canvas.setFont('Helvetica-Bold', 18)
+        canvas.drawString(34, 12.5, BRAND_NAME)
+        canvas.setFont('Helvetica', 7.5)
+        canvas.drawString(34, 1.5, BRAND_FULL_NAME)
+        canvas.restoreState()
